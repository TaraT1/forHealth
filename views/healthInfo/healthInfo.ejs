<section class = "container-fluid container-fluid-custom pb-5 mb-5"
    <div class="row mt-5">
        <div class="col col-lg-6 d-flex mx-auto justify-content-between align-items_center mb-3">
            <h2>Health Information for <%= healthInfo.profile.name %> </h2>

            <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" id="deleteButton" data-bs-target="#deleteModal">
                Delete
            </button>
        </div>
    </div>

    <div class="container-fluid container-fluid-custom pb-5 mb-5">
        <div>
            <div class="col-lg-6 mx-auto">
                <form class="row g-3" action="/healthInfo/update/<%= healthInfo._id %>" method="POST" enctype="multipart/form-data">

                    <%- include('_form_fields') %>

                    <div class="d-flex btn-row justify-content-between pt-3">
                        <a type="text" class="btn btn-secondary btn-lg" href="/healthInfo">Cancel</a>

                        <button type="submit" class="btn btn-primary btn-lg">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</section>

<div class="modal fade tabindex="-1" role="dialog" id="deleteModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete this health information?</h5>
                <button type="button" class="btn-close" data-bs-dismss="modal" aria-label="Close">
                </button>
                <div class="modal-body">
                    <p> You are about to delete<br> 
                        the health information for <br>
                        <%= healthInfo.profile.name %>.<br/>
                        Are you sure?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>

                    <form action="/healthInfo/<%= healthInfo._id %>?_method=DELETE" method="POST" class="position-relative">
                        <button type="submit" class="btn btn-primary">
                            Delete Health Information
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
    
    
