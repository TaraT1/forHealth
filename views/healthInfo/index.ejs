<div class="container container-fluid container-fluid-custom pb-5 mb-5">
  <div class="row mb-4">
    <div class="col">
      <h1>Health Information</h1>
    </div>

    <%- include('../partials/_navbar') %>

    <div class="col text-end">
      <a href="/healthInfo/new" class="btn btn-primary">Add Health Information</a>
    </div>
  </div>

  <div class="container container-fluid container-fluid-custom">
    <div class="row">
      <% healthInfoRecords.forEach(function(record) { %>
      <div class="col-sm-4 mb-4">
        <div class="card border-primary" style="min-height: 60px">
          <a
            href="/healthInfo/<%= record._id %>"
            class="card-body text-decoration-none">
            <h5 class="card-title"><%= record.profile.name %></h5>
          </a> 
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
