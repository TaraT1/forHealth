<section class="container-fluid container-fluid-custom pb-5 mb-5">
    <div class="row mt-5">
        <div class="col col-lg-6 mx-auto">
            <h2>Add Health Information</h2>
        </div>

        <form action="/healthInfo" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="profile">Select Profile</label>
                <select name="profile" ide="profile" class="form-control">
                    <% profiles.forEach(function(profile) { %>
                        <option value="<%= profile._id %>"><%= profile.name %></option>
                    <% }) %>
                </select>
            </div>

            <%- include("_form_fields") %>

            <div class="d-flex justify-content-between pt-3" >
                <a type="text" class="btn btn-secondary btn-lg"
                href="/healthInfo">Cancel</a>
                <button type="submit" class="btn btn-primary btn-lg">
                    Create
                </button>
            </div>
        </form>
    </div>
</section>