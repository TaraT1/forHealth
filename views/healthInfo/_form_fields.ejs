<div class="row mt-3">
    <h3>Conditions</h3>
    <div> <label for="conditionName" class="form-label">Medical Condition </label>
        <input type="text" class="form-control" id="conditionName" name="conditionName" value="<%= healthInfo.conditions.name%>">
    </div>
    <div>
        <label for="conditionType" class="form-label">Condition Type</label>
        <input type="text" class="form-control" id="conditionType" name="conditionType" value="<%= healthInfo.conditions.type %>">
    </div> <div>
        <label for="conditionNote" class="form-label">Note for Condition</label>
        <input type="text" class="form-control" id="conditionNote" name="conditionNote" value="<%= healthInfo.conditions.note %>">
    </div>
</div>

<div class="row mt-3"> 
    <h3>Prescriptions</h3>
    <div class="col col-md-8">
        <label for="prescriptionName" class="form-label">Prescription Name</label>
        <input type="text" class="form-control" id="prescriptionName" name="prescriptionName" value="<%#=healthInfo.prescriptionName%>">
    </div>

    <div class="col col-md-4">
        <label for="prescriptionDosage" class="form-label">Dose</label>
        <input type="text" class="form-control" id="prescriptionDosage" name="prescriptionDosage" value="<%#=healthInfo.prescriptionDosage%>">
    </div>

    <div class="col col-md-12">
        <label for="prescriber" class="form-label">Prescriber</label>
        <input type="text" class="form-control" id="prescriber"
        name="prescriber" value="<%#=healthInfo.prescriber%>">
    </div>

    <div class="col col-md-4">
        <label for="startDate" class="form-label" >Start Date </label>
        <input type="date" class="form-control" id="startDate" name="startDate" value="<%#=healthInfo.scripStartDate == null ? '' : healthInfo.startDate.toISOString().slice(0,10) %>">
    </div>

    <div class="col col-md-4">
        <label for="endDate" class="form-label" >End Date</label>
        <input type="date" class="form-control" id="endDate" name="endDate" value="<%#=healthInfo.scripEndDate == null ? '' : healthInfo.endDate.toISOString().slice(0,10) %>">
    </div>
</div>

<div class="row mt-3">
    <h3>Vaccinations</h3>
    <div class="col-md-8">
        <label for="vaxName" class="form-label">Vaccination Name</label>
        <input type="text" class="form-control" id="vaxName" name="vaxName" value="<%#=healthInfo.vaxName%>">
    </div>

    <div class="col-md-4">
        <label for="vaxDosage" class="form-label">Dose</label>
        <input type="text" class="form-control" id="vaxDosage" name="vaxDosage" value="<%#=healthInfo.vaxDosage%>">
    </div>

    <div class="col-md-12">
        <label for="vaxPrescriber" class="form-label">Prescriber</label>
        <input type="text" class="form-control" id="vaxPrescriber"
        name="vaxPrescriber" value="<%#=healthInfo.vaxPrescriber%>">
    </div>

    <div class="col-md-4">
        <label for="vaxDate" class="form-label" >Vaccination Date </label>
        <input type="date" class="form-control" id="vaxDate" name="vaxDate" value="<%#=healthInfo.vaxDate == null ? '' : healthInfo.vaxDate.toISOString().slice(0,10) %>">
    </div>
</div>

<div class="row mt-3">
    <h3>Allergies</h3>
    <div>
        <label for="allergyTrigger" class="form-label"> Allergy Trigger</label>
        <input type="text" class="form-control" id="allergyTrigger" name="allergyTrigger" 
        value="<%#= healthInfo.allergyTrigger %>">
    </div> 
    <div>
        <label for="allergyType" class="form-label">Type of Allergy </label>
        <input type="text" class="form-control" id="allergyType" name="allergyType" value="<%#= healthInfo.allergiesType %>">
    </div>
    <div>
        <label for="allergyReaction" class="form-label">Allergy Reaction </label>
        <input type="text" class="form-control" id="allergyReaction" name="reaction" value="<%#= healthInfo.allergyValue %>">
    </div>
    <div>
        <label for="allergyNote" class="form-label">Note for Allergy</label>
        <input type="text" class="form-control" id="allergyNote" name="allergyNote" value="<%#= healthInfo.allergyNote %>"> </div>
</div>

<div class="row mt-3">
    <h3> Recommendations for Care </h3>
    <div class="col-md-12">
        <label for="recommendation" class="form-label">Recommendation</label>
        <textarea row="3" class="form-control" id="recommendation" name="recommendation" value="<%#= healthInfo.recName %>"></textarea>
    </div>
    <div class="col-md-6">
        <label for="recDescription" class="form-label">Recommendation Description</label>
        <textarea row="3" class="form-control" id="recDescription"
        name="recDescription" value="<%#=healthInfo.recDescription %>"></textarea>
    </div>
    <div class="col-md-4">
        <label for="status" class="form-label">Status</label>
        <input type="text" class="form-control" id="status"
        name="healthInfo.recStatus" value="<%#=healthInfo.recStatus %>">
    </div>
</div>

<div class="row mt-3">
    <h3>Medical Event</h3>
    <div class="col-md-8">
        <label for="eventTitle" class="form-label">Medical Event </label>
        <input type="eventTitle" class="form-control" id="eventTitle" name="eventTitle" 
        value="<%#= healthInfo.eventTitle%>">
    </div>

    <div class="col-md-4">
        <label for="eventDate" class="form-label">Event Date</label>
        <input type="eventDate" class="form-control" id="eventDate" 
        name="eventDate" value="<%#= healthInfo.eventDate == null ? '' : healthInfo.eventDate.toISOString().slice(0,10) %>">
    </div>

    <div>
        <label for="eventDescription" class="form-label">Event Description </label>
        <textarea class="form-control" id="eventDescription" name="eventDescription" value="<%#= healthInfo.eventDescription %>"></textarea>
    </div>
    <div>
        <label for="outcome" class="form-label">Event Outcome</label>
        <input type="text" class="form-control" id="eventOutcome"
        name="eventOutcome" value="<%#= healthInfo.eventOutcome %>">
    </div>
</div>