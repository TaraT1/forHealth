<div class="col-md-10">
    <h2>Add Your Profile Information</h2>
    <p>Your personal profile will be called My Profile by default</p>
</div>

  <div class="row mt-3">
    <div class="col col-md-6">
      <label for="name" class="form-label">Name for Profile</label>
      <input type="text" class="form-control" id="name" name="name" value="<%= profile.name %>">
    </div>
  </div>

  <div class="row">
      <div class="col col-md-6">
        <label for="firstName" class="form-label">First Name</label>
        <input type="text" class="form-control" id="firstName"
        name="firstName" value="<%=profile.firstName %>"> 
      </div>
      
      <div class="col col-md-6">
        <label for="lastName" class="form-label">Last Name</label> <input type="text" class="form-control" id="lastName"
        name="lastName" value="<%=profile.lastName %>"> 
      </div>
  </div>

  <div class="row">
      <div class="col col-md-6">
        <label for="phone" class="form-label">Phone</label>
        <input type="text" class="form-control" id="phone"
        name="phone" value="<%=profile.phone%>">
      </div>

      <div class="col col-md-6">
        <label for="email" class="form-label">Email</label>
        <input type="text" class="form-control" id="email"
        name="email" value="<%=profile.email%>">
      </div>
  </div>

    <div class="col-md-12">
      <label for="address" class="form-label">Address</label>
      <textarea class="form-control" id="address" name="address" rows="3"> <%=profile.address%>
      </textarea>
    </div>

  <div class="row">
    <div class="col col-md-6">
        <label for="birthDate" class="form-label">Birthdate</label>
        <input type="date" class="form-control" id="birthDate" name="birthDate" value="<%= profile.birthDate == null ? '' : profile.birthDate.toISOString().slice(0,10) %>">
    </div> 

    <div class="col col-md-6"> 
        <label for="bloodType" class="form-label">Blood type</label>
        <input type="text" class="form-control" id="bloodType" name="bloodType" value="<%= profile.bloodType %>">
    </div>
  </div>

  <div class="col-md-12">
    <label for="inCaseOfEmergency" class="form-label"><h3>Emergency Contact Info</h3></label>
    <textarea class="form-control" id="inCaseOfEmergency" rows="3"
    name="inCaseOfEmergency"> <%=profile.inCaseOfEmergency%>
    </textarea>
  </div>

  <div class="col-md-12">
  
    <label for="insurance" class="form-label"><h3>Insurance</h3></label>
    <textarea class="form-control" id="insurance" name="insurance" placeholder="Insurance company, id, expiration"> <%= profile.insurance %>
    </textarea>
  </div>

  <div class="col-md-12">
    <label for="insuranceNotes" class="form-label">Insurance Notes</label>
    <textarea class="form-control" id="insuranceNotes" name="insuranceNotes"> <%= profile.insuranceNotes %>
    </textarea>
  </div>

  <div>
    <label for="eHealthRecords" class="form-label"><h3>eHealth Records</h3></label>
    <textarea class="form-control" id="eHealthRecords" rows="4" name="eHealthRecords"> <%= profile.eHealthRecords %>
    </textarea>
  </div>

  <div>
  <label for="journal" class="form-label"><h3>Journal</h3></label>
    <textarea class="form-control" id="journal" name="journal" rows="3"> <%= profile.journal %>
    </textarea>
  </div>
  
  <div>
    <label for="imgUpload" class="form-label"><h3>Image Upload<h3></label>
    <input type="file" class="form-control" id="imgUpload" name="file">
  </div>