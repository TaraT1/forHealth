<h3>Insurance Information</h3>
<div class="col-md-12">
    <label for="insurance" class="form-label">Insurance Information</label>
    <textarea class="form-control" id="insurance" name="insurance" value="<%= profile.insurance %>">
</div>

<div class="col-md-12">
    <label for="insuranceNotes" class="form-label">Insurance Information</label>
    <textarea class="form-control" id="insuranceNotes" name="insuranceNotes" value="<%= profile.insuranceNotes %>">
</div>

<div class="col-md-6"> 
    <label for="bloodType" class="form-label">Blood type</label>
    <input type="text" class="form-control" id="bloodType" name="bloodType" value="<%= profile.bloodType %>">
</div>

<h3>In Case of Emergency</h3>
<div class="col-md-6">
    <label for="inCaseOfEmergency" class="form-label">Emergency Contact Info</label>
    <textarea class="form-control" id="inCaseOfEmergency" rows="2"
    name="inCaseOfEmergency" value="<%=profile.inCaseOfEmergency%>">
    </textarea>
</div>

<div>
    <label for="eHealthRecords" class="form-label"><h3>eHealth Records</h3></label>
    <textarea class="form-control" id="eHealthRecords" rows="2" name="eHealthRecords" value="<%= profile.eHealthRecords %>">
    </textarea>
</div>

<div>
    <label for="journal" class="form-label"><h3>Journal</h3></label>
    <textarea class="form-control" id="journal" name="journal" rows="3" value="<%= profile.journal %>">
    </textarea>
</div>

<div>
    <label for="imgUpload" class="form-label"><h3>Image Upload<h3></label>
    <input type="file" class="form-control" id="imgUpload" name="file">
</div>