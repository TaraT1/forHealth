<div class="col-md-10">
<label for="name" class="form-label">Facility Name</label>
<input type="text" class="form-control" id="name" name="name" required value="<%= facility.name %>">
</div>

<div>
<label for="type" class="form-label">Facility type</label>
<input type="text" class="form-control" id="type" name="type" value="<%#=facility.type%>">
</div>

<div class="col-md-6">
  <label for="phone" class="form-label">Phone</label>
  <input type="text" class="form-control" id="phone"
  name="phone" value="<%=facility.phone%>">
</div>

<div class="col-md-6">
  <label for="email" class="form-label">Email</label>
  <input type="text" class="form-control" id="email"
  name="email" value="<%=facility.email%>">
</div>

<div class="col-md-12">
  <label for="address" class="form-label">Address</label>
  <input type="text" class="form-control" id="address"
  name="address" vlaue="<%=facility.address%>">
</div>

<div class="col-md-6">
  <label for="city" class="form-label">City</label>
  <input type="text" class="form-control" id="city"
  name="city" vlaue="<%#=facility.city%>">
</div>

<div class="col-md-4">
  <label for="state" class="form-label">State</label>
  <input type="text" class="form-control" id="state"
  name="state" vlaue="<%#=facility.state%>">
</div>

<div class="col-md-2">
  <label for="zip" class="form-label">Zip</label>
  <input type="text" class="form-control" id="zip"
  name="zip" vlaue="<%#=facility.zip%>">
</div>

<div> 
  <label for="website" class="form-label">Website</label> <input type="text" class="form-control" id="website" name="website" value="<%= facility.website %>">
</div>

<div>
    <label for="socials" class="form-label">Socials</label>
    <textarea class="form-control" id="socials" name="socials" rows="3" value="<%=facility.socials %>"> </textarea>
</div>

<div>
    <label for="notes" class="form-label">Notes</label>
    <textarea class="form-control" id="notes" name="notes" rows="3" value="<%= facility.notes %>"> </textarea>
</div>

<div>
    <label for="media" class="form-label">Media</label>
    <input type="file" class="form-control" id="media" name="media" value="<%= facility.media %>">
</div>

